From 0edc8ca70db4b962108f7c43043bd458d22f051f Mon Sep 17 00:00:00 2001
From: Jellyfrog <Jellyfrog@users.noreply.github.com>
Date: Thu, 12 Nov 2026 17:27:07 +0100
Subject: [PATCH] libsnmp: Release the textual conventions of unloaded modules

netsnmp_unload_module() removed the module's nodes but kept its
textual conventions in tclist. Modules read later could still resolve
them, e.g. through an import from a module that is not found, which
matches any module, so the tree depended on which modules had been
loaded before.

Free the entries of the module. Nodes refer to textual conventions by
index, so the entries stay in place and a NULL descriptor marks them
as free; lookups skip them and new definitions reuse them.
---
 snmplib/parse.c | 25 ++++++++++++++++++++++++-
 1 file changed, 24 insertions(+), 1 deletion(-)

diff --git a/snmplib/parse.c b/snmplib/parse.c
index 2d44fff552..b2b4d06c2b 100644
--- a/snmplib/parse.c
+++ b/snmplib/parse.c
@@ -2554,6 +2554,8 @@ get_tc_index(const char *descriptor, int modid)
     for (i = 0, tcp = tclist; i < tc_alloc; i++, tcp++) {
         if (tcp->type == 0)
             break;
+        if (tcp->descriptor == NULL)    /* released by netsnmp_unload_module() */
+            continue;
         if (!label_compare(descriptor, tcp->descriptor) &&
             ((modid == tcp->modid) || (modid == -1))) {
             return i;
@@ -2882,7 +2884,7 @@ parse_asntype(FILE * fp, char *name, int *ntype, char *ntoken)
         tcp = NULL;
         is_duplicate = 0;
         for (i = 0; i < tc_alloc; i++) {
-            if (tclist[i].type == 0) {
+            if (tclist[i].type == 0 || tclist[i].descriptor == NULL) {
                 if (tcp == NULL)
                     tcp = &tclist[i];
             } else if (strcmp(name, tclist[i].descriptor) == 0 &&
@@ -4691,6 +4693,27 @@ netsnmp_unload_module(const char *name)
         free(mp->imports);
     }
     mp->imports = NULL;
+    /*
+     * Release the module's textual conventions, so that modules read later
+     * cannot resolve them. Nodes refer to them by index, so the entries
+     * stay in place: a NULL descriptor marks them as free. The type stays
+     * set because lookups stop at the first entry with type 0.
+     */
+    {
+        int             i;
+        struct tc      *tcp;
+
+        for (i = 0, tcp = tclist; i < tc_alloc && tcp->type != 0; i++, tcp++) {
+            if (tcp->modid != modID || tcp->descriptor == NULL)
+                continue;
+            free_enums(&tcp->enums);
+            free_ranges(&tcp->ranges);
+            SNMP_FREE(tcp->descriptor);
+            SNMP_FREE(tcp->hint);
+            SNMP_FREE(tcp->description);
+            tcp->modid = -1;
+        }
+    }
     mp->no_imports = -1;        /* mark as unloaded */
     return MODULE_LOADED_OK;    /* Well, you know what I mean! */
 }
-- 
