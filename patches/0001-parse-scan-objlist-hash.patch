From bfe9b106fbf54b43150af07b1f6f071214cdd4b9 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 7 Nov 2026 13:09:03 +0000
Subject: [PATCH 4/5] libsnmp: Pass MAXTOKEN to get_token() in
 parse_objectgroup()

The token after the OBJECTS or NOTIFICATIONS list was read with the
token type RIGHTBRACKET as maximum length, so a label of more than 30
characters at that position was truncated and reported as too long.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_019ZWdUfDKjFE17nkAqveRsB
---
 snmplib/parse.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/snmplib/parse.c b/snmplib/parse.c
index ccb2482a4..eb888bae0 100644
--- a/snmplib/parse.c
+++ b/snmplib/parse.c
@@ -3277,7 +3277,7 @@ parse_objectgroup(FILE * fp, char *name, int what, struct objgroup **ol)
             print_error("Expected \"}\" after list", token, type);
             goto skip;
         }
-        type = get_token(fp, token, type);
+        type = get_token(fp, token, MAXTOKEN);
     }
     if (type != STATUS) {
         print_error("Expected STATUS", token, type);
-- 
