From 3a25d369028e0be9ee701c04cbaa1db5d5c8ba18 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 7 Nov 2026 13:09:04 +0000
Subject: [PATCH 5/5] libsnmp: Do not add parsed nodes to the label table twice

parse() added the previous tail of the node list to the label table again
each time a new definition was appended. That was a no-op that cost a
hash computation and a table lookup for about half of all
label_table_add() calls. Only add the new nodes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_019ZWdUfDKjFE17nkAqveRsB
---
 snmplib/parse.c | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/snmplib/parse.c b/snmplib/parse.c
index eb888bae0..4bff3ed3a 100644
--- a/snmplib/parse.c
+++ b/snmplib/parse.c
@@ -5334,12 +5334,15 @@ parse(FILE * fp)
                     np->next = nnp;
                 else
                     np = root = nnp;
-                if (label_table_add(&labels, np) < 0)
-                    goto out_of_memory;
-                while (np->next) {
-                    np = np->next;
+                /*
+                 * The previous tail of the list has already been added to
+                 * the label table.
+                 */
+                for (np = nnp; ; np = np->next) {
                     if (label_table_add(&labels, np) < 0)
                         goto out_of_memory;
+                    if (!np->next)
+                        break;
                 }
                 if (np->type == TYPE_OTHER)
                     np->type = type;
-- 
2.56.0

