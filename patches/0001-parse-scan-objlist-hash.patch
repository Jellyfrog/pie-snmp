From 4c0f239a88489891472c78241ebd1736ce717a9a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 7 Nov 2026 13:09:03 +0000
Subject: [PATCH 3/5] libsnmp: Parse MODULE clauses that name the current
 module

If a MODULE-COMPLIANCE MODULE clause names the current module, e.g.
"MODULE IF-MIB" inside IF-MIB, parse_compliance() did not consume the
module name. The name was then taken for the next clause, so
MANDATORY-GROUPS, GROUP and OBJECT were never seen, the rest of the
compliance statement was skipped and undefined groups in it were never
reported. Consume the module name and treat the clause like one without
a module name.

Extend T165 with such a clause.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_019ZWdUfDKjFE17nkAqveRsB
---
 snmplib/parse.c                               | 21 ++++++++++++-------
 .../fulltests/default/T165mibundefined_simple | 10 ++++++++-
 2 files changed, 22 insertions(+), 9 deletions(-)

diff --git a/snmplib/parse.c b/snmplib/parse.c
index 4f3cd4e01..ccb2482a4 100644
--- a/snmplib/parse.c
+++ b/snmplib/parse.c
@@ -3650,15 +3650,20 @@ parse_compliance(FILE * fp, char *name)
         int             modid = -1;
         char            modname[MAXTOKEN];
         type = get_token(fp, token, MAXTOKEN);
-        if (type == LABEL
-            && strcmp(token, module_name(current_module, modname))) {
-            modid = read_module_internal(token);
-            if (modid != MODULE_LOADED_OK
-                && modid != MODULE_ALREADY_LOADED) {
-                print_error("Unknown module", token, type);
-                goto skip;
+        if (type == LABEL) {
+            /*
+             * A MODULE clause that names the current module is equivalent
+             * to one without a module name.
+             */
+            if (strcmp(token, module_name(current_module, modname))) {
+                modid = read_module_internal(token);
+                if (modid != MODULE_LOADED_OK
+                    && modid != MODULE_ALREADY_LOADED) {
+                    print_error("Unknown module", token, type);
+                    goto skip;
+                }
+                modid = which_module(token);
             }
-            modid = which_module(token);
             type = get_token(fp, token, MAXTOKEN);
         }
         if (type == MANDATORYGROUPS) {
diff --git a/testing/fulltests/default/T165mibundefined_simple b/testing/fulltests/default/T165mibundefined_simple
index 8c308fa98..fc67becf1 100755
--- a/testing/fulltests/default/T165mibundefined_simple
+++ b/testing/fulltests/default/T165mibundefined_simple
@@ -52,6 +52,13 @@ testCompliance MODULE-COMPLIANCE
         MANDATORY-GROUPS { testObjects, undefinedGroup }
     ::= { testUndefinedMib 3 }
 
+testComplianceSelf MODULE-COMPLIANCE
+    STATUS current
+    DESCRIPTION "Undefined group in a MODULE clause naming this module."
+    MODULE TEST-UNDEFINED-MIB
+        MANDATORY-GROUPS { testNotifications, undefinedSelfGroup }
+    ::= { testUndefinedMib 7 }
+
 definedObject OBJECT-TYPE
     SYNTAX      Integer32
     MAX-ACCESS  read-only
@@ -81,6 +88,7 @@ CHECK ".1.3.6.1.4.1.99993.4"
 CHECK "^Undefined OBJECT (undefinedObject)"
 CHECK "^Undefined NOTIFICATION (undefinedNotification)"
 CHECK "^Undefined OBJECT-GROUP (undefinedGroup)"
-CHECKCOUNT 3 "^Undefined "
+CHECK "^Undefined OBJECT-GROUP (undefinedSelfGroup)"
+CHECKCOUNT 4 "^Undefined "
 
 FINISHED
-- 
