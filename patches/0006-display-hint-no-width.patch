From dac8e5c43e7a09ae1aa6f9749757dfa2e39596b5 Mon Sep 17 00:00:00 2001
From: Jellyfrog <Jellyfrog@users.noreply.github.com>
Date: Fri, 13 Nov 2026 14:04:38 +0100
Subject: [PATCH] libsnmp: Use one octet for display hint specs without a
 length

Commit 4d779b690 ("Fix zero-width display hint handling per RFC 2579")
removed the width = 1 fallback for malformed hint strings. A spec
without an octet length, e.g. DISPLAY-HINT "t" in EQLGROUP-MIB, is now
handled as a zero-width spec and the value prints as an empty string.

Only treat an explicit zero length (e.g. "0a[") as a zero-width spec and
use one octet for a spec without a length, like before.
---
 snmplib/mib.c                                 | 10 ++++++++-
 .../T025sprint_realloc_octet_string_clib.c    | 21 +++++++++++++++++++
 2 files changed, 30 insertions(+), 1 deletion(-)

diff --git a/snmplib/mib.c b/snmplib/mib.c
index c6d652b1d..df096674a 100644
--- a/snmplib/mib.c
+++ b/snmplib/mib.c
@@ -473,7 +473,7 @@ sprint_realloc_octet_string(u_char ** buf, size_t * buf_len,
 
 
     if (hint) {
-        int             repeat, width = 1;
+        int             repeat, width = 1, has_width;
         unsigned long   value;
         char            code = 'd', separ = 0, term = 0, ch, intbuf[32];
 #define HEX2DIGIT_NEED_INIT 3
@@ -497,6 +497,7 @@ sprint_realloc_octet_string(u_char ** buf, size_t * buf_len,
                     hint++;
                 }
                 width = 0;
+                has_width = '0' <= *hint && *hint <= '9';
                 while ('0' <= *hint && *hint <= '9')
                     width = (width * 10) + (*hint++ - '0');
                 code = *hint++;
@@ -512,6 +513,13 @@ sprint_realloc_octet_string(u_char ** buf, size_t * buf_len,
                     term = *hint++;
                 else
                     term = 0;
+                /*
+                 * A spec without an octet length (e.g. "t") is malformed,
+                 * use one octet like before. Only an explicit zero length
+                 * (e.g. "0a[") is a zero-width spec.
+                 */
+                if (!has_width)
+                    width = 1;
             }
 
             /*
diff --git a/testing/fulltests/unit-tests/T025sprint_realloc_octet_string_clib.c b/testing/fulltests/unit-tests/T025sprint_realloc_octet_string_clib.c
index 99332af31..5206e829f 100644
--- a/testing/fulltests/unit-tests/T025sprint_realloc_octet_string_clib.c
+++ b/testing/fulltests/unit-tests/T025sprint_realloc_octet_string_clib.c
@@ -220,6 +220,27 @@ static const struct {
         data_three,
         3,
         "2580-30"
+    },
+    {
+        "malformed utf-8 hint without length uses one octet",
+        "t",
+        data_ascii,
+        5,
+        "Hello"
+    },
+    {
+        "malformed ascii hint without length uses one octet",
+        "a",
+        data_ascii,
+        5,
+        "Hello"
+    },
+    {
+        "malformed decimal hint without length uses one octet",
+        "d.",
+        data_two,
+        2,
+        "10.20"
     }
 };
 
