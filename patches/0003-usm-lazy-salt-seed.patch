From b74831f98046f70fccfffe41b4dd8ab5cc8f5458 Mon Sep 17 00:00:00 2001
From: Jellyfrog <Jellyfrog@users.noreply.github.com>
Date: Tue, 10 Nov 2026 19:55:06 +0100
Subject: [PATCH 1/3] libsnmp: Seed the USM salts when they are needed for the
 first time

At startup, init_usm_post_config() calls sc_random() three times to
seed the DES and AES salts. With OpenSSL, the first RAND_bytes() call
starts the DRBG. This is one of the most expensive steps when the
command-line tools start. Only SNMPv3 with privacy uses the salts. For
SNMPv1, SNMPv2c and SNMPv3 without privacy, this work is not necessary.

This change seeds the salts when usm_set_salt() or usm_set_aes_iv()
needs them for the first time. init_usm_post_config() clears the
"seeded" flag. Thus the salts get new seeds after a reconfiguration,
as before.

The flag is set only after all salts are written. Thus a concurrent
first caller seeds the salts again and does not use all-zero salts.
The DES salt is declared and seeded only when DES support is compiled
in.

User-space instructions (median of 101 runs, static build, OpenSSL):

| Command                  |     Before |      After | Change |
|:-------------------------|-----------:|-----------:|-------:|
| `snmptranslate`          | 11,058,867 |  8,235,722 | -25.5% |
| `snmpget -v2c`           | 11,562,052 |  8,529,044 | -26.2% |
| `snmpget -v3 authNoPriv` | 24,035,208 | 21,005,458 | -12.6% |
| `snmpget -v3 authPriv`   | 36,304,788 | 36,295,817 |  -0.0% |

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 snmplib/snmpusm.c | 82 +++++++++++++++++++++++++++++++----------------
 1 file changed, 54 insertions(+), 28 deletions(-)

diff --git a/snmplib/snmpusm.c b/snmplib/snmpusm.c
index bf898206a..6d848cf23 100644
--- a/snmplib/snmpusm.c
+++ b/snmplib/snmpusm.c
@@ -223,7 +223,9 @@ static size_t   defaultPrivTypeLen = 0;
 /*
  * Globals.
  */
+#ifndef NETSNMP_DISABLE_DES
 static u_int    salt_integer;
+#endif
 #ifdef HAVE_AES
 static u_int    salt_integer64_1, salt_integer64_2;
 #endif
@@ -231,6 +233,54 @@ static u_int    salt_integer64_1, salt_integer64_2;
          * 1/2 of seed for the salt.   Cf. RFC2274, Sect 8.1.1.1.
          */
 
+/*
+ * Not read if neither DES nor AES support has been compiled in.
+ */
+static int      salts_seeded NETSNMP_ATTRIBUTE_UNUSED;
+
+#if !defined(NETSNMP_DISABLE_DES) || defined(HAVE_AES)
+/*
+ * Fill *salt with random data, falling back to time() if sc_random() fails.
+ */
+static void
+usm_seed_salt(u_int *salt, const char *name)
+{
+    size_t          salt_len = sizeof(*salt);
+
+    if (sc_random((u_char *) salt, &salt_len) != SNMPERR_SUCCESS) {
+        DEBUGMSGTL(("usm", "sc_random() failed: using time() as %s.\n",
+                    name));
+        *salt = time(NULL);
+    }
+}
+
+/*
+ * Seed the "arbitrary" portion of the salts with random numbers. This is
+ * deferred until a salt is needed for the first time because initializing
+ * the random number generator is expensive and is not necessary for
+ * SNMPv1/v2c or for SNMPv3 without privacy.
+ */
+static void
+usm_seed_salts(void)
+{
+    if (salts_seeded)
+        return;
+
+#ifndef NETSNMP_DISABLE_DES
+    usm_seed_salt(&salt_integer, "salt");
+#endif
+#ifdef HAVE_AES
+    usm_seed_salt(&salt_integer64_1, "aes1 salt");
+    usm_seed_salt(&salt_integer64_2, "aes2 salt");
+#endif
+    /*
+     * Only set the flag once the salts have been written, so that a
+     * concurrent caller seeds them again instead of using unseeded salts.
+     */
+    salts_seeded = 1;
+}
+#endif /* !NETSNMP_DISABLE_DES || HAVE_AES */
+
 static struct usmUser *noNameUser = NULL;
 /*
  * Local storage (LCD) of the default user list.
@@ -1240,6 +1290,7 @@ usm_set_salt(u_char * iv,
     }
 
 
+    usm_seed_salts();
     net_boots = htonl(snmpv3_local_snmpEngineBoots());
     net_salt_int = htonl(salt_integer);
 
@@ -1309,6 +1360,7 @@ usm_set_aes_iv(u_char * iv,
         return -1;
     }
 
+    usm_seed_salts();
     net_salt_int1 = htonl(salt_integer64_1);
     net_salt_int2 = htonl(salt_integer64_2);
 
@@ -5199,39 +5251,13 @@ init_usm_conf(const char *app)
  * initializations for the USM.
  *
  * Should be called after the (engineid) configuration files have been read.
- *
- * Set "arbitrary" portion of salt to a random number.
  */
 static int
 init_usm_post_config(int majorid, int minorid, void *serverarg,
                      void *clientarg)
 {
-    size_t          salt_integer_len = sizeof(salt_integer);
-    uint64_t        current_time;
-
-    if (sc_random((u_char *) & salt_integer, &salt_integer_len) !=
-        SNMPERR_SUCCESS) {
-        DEBUGMSGTL(("usm", "sc_random() failed: using time() as salt.\n"));
-        current_time = time(NULL);
-        salt_integer = current_time;
-    }
-
-#ifdef HAVE_AES
-    salt_integer_len = sizeof (salt_integer64_1);
-    if (sc_random((u_char *) & salt_integer64_1, &salt_integer_len) !=
-        SNMPERR_SUCCESS) {
-        DEBUGMSGTL(("usm", "sc_random() failed: using time() as aes1 salt.\n"));
-        current_time = time(NULL);
-        salt_integer64_1 = current_time;
-    }
-    salt_integer_len = sizeof (salt_integer64_1);
-    if (sc_random((u_char *) & salt_integer64_2, &salt_integer_len) !=
-        SNMPERR_SUCCESS) {
-        DEBUGMSGTL(("usm", "sc_random() failed: using time() as aes2 salt.\n"));
-        current_time = time(NULL);
-        salt_integer64_2 = current_time;
-    }
-#endif
+    /* Reseed the salts the next time one is needed. */
+    salts_seeded = 0;
 
     // Free noNameUser before it is assigned
     usm_free_user(noNameUser);
-- 
2.56.0


From 17105b0bb51e7498bb9693b4624ea565469890db Mon Sep 17 00:00:00 2001
From: Jellyfrog <Jellyfrog@users.noreply.github.com>
Date: Tue, 10 Nov 2026 21:34:45 +0100
Subject: [PATCH 2/3] testing: Verify that the USM privacy salts are seeded

The salts are seeded the first time that they are used. If seeding
stops working, the salts start at zero. All other tests continue to
pass, because no test examines the salt values.

This unit test builds two SNMPv3 authPriv messages for AES and DES. It
reads msgPrivacyParameters from the encoded packets. It verifies that
the random part of the first salt is not all zeros and that the salts
of the two messages are different.
---
 .../unit-tests/T122usm_salt_seed_clib.c       | 167 ++++++++++++++++++
 1 file changed, 167 insertions(+)
 create mode 100644 testing/fulltests/unit-tests/T122usm_salt_seed_clib.c

diff --git a/testing/fulltests/unit-tests/T122usm_salt_seed_clib.c b/testing/fulltests/unit-tests/T122usm_salt_seed_clib.c
new file mode 100644
index 000000000..0e23b0513
--- /dev/null
+++ b/testing/fulltests/unit-tests/T122usm_salt_seed_clib.c
@@ -0,0 +1,167 @@
+/* HEADER USM privacy salts are seeded and change between messages */
+
+/*
+ * The USM salts are seeded with random data the first time that they are
+ * used. This test builds two SNMPv3 authPriv messages for each privacy
+ * protocol and reads msgPrivacyParameters from the encoded packets. It
+ * verifies that:
+ * 1. The random part of the first salt is not all zeros. Unseeded salts
+ *    start at zero.
+ * 2. The salts of the two messages are different.
+ */
+
+#include <net-snmp/library/keytools.h>
+#include <net-snmp/library/scapi.h>
+#include <net-snmp/library/snmpusm.h>
+#include <net-snmp/library/transform_oids.h>
+
+{
+    static const u_char engineID[] = { 0x80, 0x00, 0x1f, 0x88, 0x80,
+                                       0x01, 0x02, 0x03, 0x04 };
+    static const u_char zeros[8];
+    static const struct {
+        int         type;
+        const char *name;
+        size_t      random_offset;  /* start of the random part of the salt */
+    } privs[] = {
+#ifdef HAVE_AES
+        { USM_CREATE_USER_PRIV_AES, "AES", 0 },
+#endif
+#ifndef NETSNMP_DISABLE_DES
+        /* The DES salt is snmpEngineBoots followed by the random part. */
+        { USM_CREATE_USER_PRIV_DES, "DES", 4 },
+#endif
+        { 0, NULL, 0 }
+    };
+    const oid      *auth_oid, *priv_oid;
+    size_t          auth_len = 0, priv_len = 0;
+    int             i, n;
+
+    SOCK_STARTUP;
+    init_snmp("T122usm_salt_seed");
+
+    /* The packet is located at the end of the buffer with reverse encoding. */
+    netsnmp_ds_set_boolean(NETSNMP_DS_LIBRARY_ID,
+                           NETSNMP_DS_LIB_REVERSE_ENCODE, 1);
+
+    for (i = 0; privs[i].name; i++) {
+        netsnmp_session session, *ss;
+        u_char          salt[2][8];
+        size_t          salt_len[2] = { 0, 0 };
+
+        snmp_sess_init(&session);
+        session.version = SNMP_VERSION_3;
+        session.peername = strdup("udp:127.0.0.1:162"); /* not used */
+        session.securityModel = SNMP_SEC_MODEL_USM;
+        session.securityEngineID = netsnmp_memdup(engineID, sizeof(engineID));
+        session.securityEngineIDLen = sizeof(engineID);
+        session.securityName = strdup(privs[i].name);
+        session.securityNameLen = strlen(privs[i].name);
+        session.securityLevel = SNMP_SEC_LEVEL_AUTHPRIV;
+        session.flags |= SNMP_FLAGS_DONT_PROBE;
+
+        auth_oid = sc_get_auth_oid(NETSNMP_USMAUTH_HMACSHA1, &auth_len);
+        session.securityAuthProto = snmp_duplicate_objid(auth_oid, auth_len);
+        session.securityAuthProtoLen = auth_len;
+        session.securityAuthKeyLen = USM_AUTH_KU_LEN;
+        generate_Ku(session.securityAuthProto, session.securityAuthProtoLen,
+                    (const u_char *)"authpassword", strlen("authpassword"),
+                    session.securityAuthKey, &session.securityAuthKeyLen);
+
+        priv_oid = sc_get_priv_oid(privs[i].type, &priv_len);
+        session.securityPrivProto = snmp_duplicate_objid(priv_oid, priv_len);
+        session.securityPrivProtoLen = priv_len;
+        session.securityPrivKeyLen = USM_PRIV_KU_LEN;
+        generate_Ku(session.securityAuthProto, session.securityAuthProtoLen,
+                    (const u_char *)"privpassword", strlen("privpassword"),
+                    session.securityPrivKey, &session.securityPrivKeyLen);
+
+        ss = snmp_open(&session);
+        OKF(ss != NULL, ("%s: open authPriv session", privs[i].name));
+        netsnmp_cleanup_session(&session);
+        if (!ss)
+            continue;
+
+        for (n = 0; n < 2; n++) {
+            netsnmp_pdu    *pdu = snmp_pdu_create(SNMP_MSG_GET);
+            size_t          pkt_len = 4096, offset = 0, len, str_len;
+            u_char         *pkt = malloc(pkt_len), *data = NULL;
+            u_char          type, str[256], secparams[256];
+            long            l;
+            int             rc;
+
+            pdu->version = SNMP_VERSION_3;
+            rc = snmp_build(&pkt, &pkt_len, &offset, ss, pdu);
+            snmp_free_pdu(pdu);
+            if (rc == 0)
+                data = pkt + pkt_len - offset;
+
+            /* SNMPv3Message: msgVersion and msgGlobalData. */
+            len = offset;
+#define PARSE(expr) if (data) data = (expr)
+#define PARSE_STR(d, buf) \
+            (str_len = sizeof(buf), asn_parse_string(d, &len, &type, buf, &str_len))
+            PARSE(asn_parse_sequence(data, &len, &type,
+                                     ASN_SEQUENCE | ASN_CONSTRUCTOR, "msg"));
+            PARSE(asn_parse_int(data, &len, &type, &l, sizeof(l)));
+            /*
+             * Skip msgGlobalData. asn_parse_sequence() sets len to the
+             * length of the sequence contents.
+             */
+            if (data) {
+                u_char         *start = data;
+                size_t          rest = len;
+
+                data = asn_parse_sequence(data, &len, &type,
+                                          ASN_SEQUENCE | ASN_CONSTRUCTOR,
+                                          "global");
+                if (data) {
+                    data += len;
+                    len = rest - (data - start);
+                }
+            }
+            PARSE(PARSE_STR(data, secparams));
+
+            /* UsmSecurityParameters: msgPrivacyParameters is the last field. */
+            if (data) {
+                data = secparams;
+                len = str_len;
+            }
+            PARSE(asn_parse_sequence(data, &len, &type,
+                                     ASN_SEQUENCE | ASN_CONSTRUCTOR, "usm"));
+            PARSE(PARSE_STR(data, str));    /* msgAuthoritativeEngineID */
+            PARSE(asn_parse_int(data, &len, &type, &l, sizeof(l)));
+            PARSE(asn_parse_int(data, &len, &type, &l, sizeof(l)));
+            PARSE(PARSE_STR(data, str));    /* msgUserName */
+            PARSE(PARSE_STR(data, str));    /* msgAuthenticationParameters */
+            PARSE(PARSE_STR(data, salt[n]));
+            if (data)
+                salt_len[n] = str_len;
+#undef PARSE_STR
+#undef PARSE
+
+            OKF(rc == 0 && data != NULL,
+                ("%s: build and parse message %d%s%s", privs[i].name, n + 1,
+                 data ? "" : ": ",
+                 data ? "" : snmp_api_errstring(ss->s_snmp_errno)));
+            free(pkt);
+        }
+
+        if (salt_len[0] == 8 && salt_len[1] == 8) {
+            size_t off = privs[i].random_offset;
+
+            OKF(memcmp(salt[0] + off, zeros, 8 - off) != 0,
+                ("%s: first salt is seeded (not all zeros)", privs[i].name));
+            OKF(memcmp(salt[0], salt[1], 8) != 0,
+                ("%s: salts of two messages are different", privs[i].name));
+        } else {
+            OKF(0, ("%s: salt lengths are %d and %d, expected 8",
+                    privs[i].name, (int)salt_len[0], (int)salt_len[1]));
+        }
+
+        snmp_close(ss);
+    }
+
+    snmp_shutdown("T122usm_salt_seed");
+    SOCK_CLEANUP;
+}
-- 
2.56.0


From 95e42b9773bf9398617471cb0ade2b4a730626ea Mon Sep 17 00:00:00 2001
From: Jellyfrog <Jellyfrog@users.noreply.github.com>
Date: Tue, 10 Nov 2026 22:16:37 +0100
Subject: [PATCH 3/3] testing: Simplify the USM salt seeding test

Walk to msgPrivacyParameters with asn_parse_header() and one chain of
parse steps. This removes the copy of the security parameters and the
separate length bookkeeping. Start with zeroed salts, so a parse failure
also fails the salt checks. Remove includes that net-snmp-includes.h
already provides.
