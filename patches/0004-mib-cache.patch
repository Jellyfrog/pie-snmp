-    return;
 }
 
 
@@ -4397,6 +4467,525 @@ read_import_replacements(const char *old_module_name,
     return read_module_replacements(old_module_name);
 }
 
+/*
+ * MIB cache
+ *
+ * Reading a module file parses its text. With the cache enabled
+ * (netsnmp_mib_cache_enable()), what parsing a file did is recorded, and
+ * reading the file again replays that instead of parsing: the start of each
+ * module, its IMPORTS (the imported modules are read again, through the
+ * cache), modules read for MODULE-COMPLIANCE MODULE and AGENT-CAPABILITIES
+ * SUPPORTS clauses, its textual conventions and its nodes, which are linked
+ * into the tree by do_linkup() as after parsing. The tree is the same as
+ * after parsing, so the tree can be rebuilt (shutdown_mib(), init_mib())
+ * for another list of modules without parsing the files again.
+ *
+ * An entry is used for the same file (path, mtime and size), MIB directories
+ * (they decide which file an imported module is read from) and parser
+ * options. Files that failed to parse, and files whose parse looked up a
+ * textual convention imported from a module that was not found (that
+ * matches whatever module is loaded), are not cached. The module index of
+ * each MIB directory (add_mibdir()) is cached too, while the directory is
+ * unchanged.
+ */
+#define MC_MODULE  1
+#define MC_IMPORTS 2
+#define MC_READ    3
+#define MC_TC      4
+#define MC_NODES   5
+
+struct mc_node {
+    struct node     node;           /* tc_index is not used */
+    char           *tc_descriptor;  /* the node's textual convention */
+    char           *tc_module;
+};
+
+struct mc_event {
+    int             kind;
+    char           *name;           /* MC_MODULE, MC_READ */
+    int             count;          /* MC_IMPORTS, MC_NODES */
+    char          **labels;         /* MC_IMPORTS */
+    int            *groups;
+    char          **names;
+    int             ngroups;
+    struct tc       tc;             /* MC_TC */
+    struct mc_node *nodes;          /* MC_NODES */
+    struct mc_event *next;
+};
+
+struct mc_entry {
+    char           *file;
+    char           *mibdirs;
+    time_t          mtime;
+    off_t           size;
+    int             options;
+    int             bad;
+    struct mc_event *events, **tail;
+    struct mc_entry *next;
+};
+
+static int      mc_enabled;
+static struct mc_entry *mc_head;
+static struct mc_entry *mc_rec;         /* the entry being recorded */
+
+/*
+ * The module index of a MIB directory (add_mibdir()): the module in each
+ * file, or none. Used while the directory and the file are unchanged.
+ */
+struct mc_dirfile {
+    char           *path;
+    char           *module;         /* NULL: not a MIB file */
+    time_t          mtime;
+    off_t           size;
+};
+
+struct mc_dir {
+    char           *name;
+    time_t          mtime;
+    int             count;
+    struct mc_dirfile *files;
+    struct mc_dir  *next;
+};
+
+static struct mc_dir *mc_dirs;
+
+static void
+mc_free_dir(struct mc_dir *d)
+{
+    int             i;
+
+    for (i = 0; i < d->count; i++) {
+        free(d->files[i].path);
+        free(d->files[i].module);
+    }
+    free(d->files);
+    free(d->name);
+    free(d);
+}
+
+static int
+mc_options(void)
+{
+    return netsnmp_ds_get_boolean(NETSNMP_DS_LIBRARY_ID, NETSNMP_DS_LIB_MIB_PARSE_LABEL)
+        | netsnmp_ds_get_boolean(NETSNMP_DS_LIBRARY_ID, NETSNMP_DS_LIB_MIB_COMMENT_TERM) << 1
+        | netsnmp_ds_get_boolean(NETSNMP_DS_LIBRARY_ID, NETSNMP_DS_LIB_SAVE_MIB_DESCRS) << 2;
+}
+
+static struct index_list *
+mc_copy_indexes(const struct index_list *sp)
+{
+    struct index_list *head = NULL, **tail = &head;
+
+    for (; sp; sp = sp->next) {
+        *tail = calloc(1, sizeof(**tail));
+        if (!*tail)
+            break;
+        (*tail)->ilabel = sp->ilabel ? strdup(sp->ilabel) : NULL;
+        (*tail)->isimplied = sp->isimplied;
+        tail = &(*tail)->next;
+    }
+    return head;
+}
+
+static struct varbind_list *
+mc_copy_varbinds(const struct varbind_list *sp)
+{
+    struct varbind_list *head = NULL, **tail = &head;
+
+    for (; sp; sp = sp->next) {
+        *tail = calloc(1, sizeof(**tail));
+        if (!*tail)
+            break;
+        (*tail)->vblabel = sp->vblabel ? strdup(sp->vblabel) : NULL;
+        tail = &(*tail)->next;
+    }
+    return head;
+}
+
+static char *
+mc_strdup(const char *s)
+{
+    return s ? strdup(s) : NULL;
+}
+
+static void
+mc_copy_node(struct node *dst, const struct node *src)
+{
+    memset(dst, 0, sizeof(*dst));
+    dst->label = mc_strdup(src->label);
+    dst->subid = src->subid;
+    dst->modid = src->modid;
+    dst->parent = mc_strdup(src->parent);
+    dst->tc_index = -1;
+    dst->type = src->type;
+    dst->access = src->access;
+    dst->status = src->status;
+    dst->enums = copy_enums(NETSNMP_REMOVE_CONST(struct enum_list *, src->enums));
+    dst->ranges = copy_ranges(NETSNMP_REMOVE_CONST(struct range_list *, src->ranges));
+    dst->indexes = mc_copy_indexes(src->indexes);
+    dst->augments = mc_strdup(src->augments);
+    dst->varbinds = mc_copy_varbinds(src->varbinds);
+    dst->hint = mc_strdup(src->hint);
+    dst->units = mc_strdup(src->units);
+    dst->description = mc_strdup(src->description);
+    dst->reference = mc_strdup(src->reference);
+    dst->defaultValue = mc_strdup(src->defaultValue);
+    dst->filename = mc_strdup(src->filename);
+    dst->lineno = src->lineno;
+}
+
+/* Free the contents of a node, not the node */
+static void
+mc_clear_node(struct node *np)
+{
+    free_enums(&np->enums);
+    free_ranges(&np->ranges);
+    free_indexes(&np->indexes);
+    free_varbinds(&np->varbinds);
+    free(np->label);
+    free(np->hint);
+    free(np->units);
+    free(np->description);
+    free(np->reference);
+    free(np->defaultValue);
+    free(np->parent);
+    free(np->augments);
+    free(np->filename);
+}
+
+static void
+mc_free_entry(struct mc_entry *e)
+{
+    struct mc_event *ev, *next;
+    int             i;
+
+    if (!e)
+        return;
+    for (ev = e->events; ev; ev = next) {
+        next = ev->next;
+        free(ev->name);
+        for (i = 0; ev->kind == MC_IMPORTS && i < ev->count; i++)
+            free(ev->labels[i]);
+        for (i = 0; ev->kind == MC_IMPORTS && i < ev->ngroups; i++)
+            free(ev->names[i]);
+        free(ev->labels);
+        free(ev->groups);
+        free(ev->names);
+        if (ev->kind == MC_TC) {
+            free_enums(&ev->tc.enums);
+            free_ranges(&ev->tc.ranges);
+            free(ev->tc.descriptor);
+            free(ev->tc.hint);
+            free(ev->tc.description);
+        }
+        for (i = 0; ev->kind == MC_NODES && i < ev->count; i++) {
+            mc_clear_node(&ev->nodes[i].node);
+            free(ev->nodes[i].tc_descriptor);
+            free(ev->nodes[i].tc_module);
+        }
+        free(ev->nodes);
+        free(ev);
+    }
+    free(e->file);
+    free(e->mibdirs);
+    free(e);
+}
+
+void
+netsnmp_mib_cache_clear(void)
+{
+    struct mc_entry *e, *next;
+    struct mc_dir  *d, *dnext;
+
+    for (e = mc_head; e; e = next) {
+        next = e->next;
+        mc_free_entry(e);
+    }
+    mc_head = NULL;
+    for (d = mc_dirs; d; d = dnext) {
+        dnext = d->next;
+        mc_free_dir(d);
+    }
+    mc_dirs = NULL;
+}
+
+void
+netsnmp_mib_cache_enable(int enable)
+{
+    mc_enabled = enable;
+    if (!enable)
+        netsnmp_mib_cache_clear();
+}
+
+static void
+mc_uncacheable(void)
+{
+    if (mc_rec)
+        mc_rec->bad = 1;
+}
+
+static struct mc_event *
+mc_add(int kind)
+{
+    struct mc_event *ev;
+
+    if (!mc_rec || mc_rec->bad)
+        return NULL;
+    ev = calloc(1, sizeof(*ev));
+    if (!ev) {
+        mc_rec->bad = 1;
+        return NULL;
+    }
+    ev->kind = kind;
+    *mc_rec->tail = ev;
+    mc_rec->tail = &ev->next;
+    return ev;
+}
+
+static void
+mc_record_module(const char *name)
+{
+    struct mc_event *ev = mc_add(MC_MODULE);
+
+    if (ev && !(ev->name = strdup(name)))
+        mc_rec->bad = 1;
+}
+
+static void
+mc_record_read(const char *name)
+{
+    struct mc_event *ev = mc_add(MC_READ);
+
+    if (ev && !(ev->name = strdup(name)))
+        mc_rec->bad = 1;
+}
+
+static void
+mc_record_imports(char **labels, const int *groups, char **names,
+                  int count, int ngroups)
+{
+    struct mc_event *ev = mc_add(MC_IMPORTS);
+    int             i;
+
+    if (!ev)
+        return;
+    ev->labels = calloc(count ? count : 1, sizeof(char *));
+    ev->groups = calloc(count ? count : 1, sizeof(int));
+    ev->names = calloc(ngroups ? ngroups : 1, sizeof(char *));
+    if (!ev->labels || !ev->groups || !ev->names) {
+        mc_rec->bad = 1;
+        return;
+    }
+    ev->count = count;
+    ev->ngroups = ngroups;
+    for (i = 0; i < count; i++) {
+        ev->labels[i] = strdup(labels[i]);
+        ev->groups[i] = groups[i];
+    }
+    for (i = 0; i < ngroups; i++)
+        ev->names[i] = strdup(names[i]);
+}
+
+static void
+mc_record_tc(const struct tc *tcp)
+{
+    struct mc_event *ev = mc_add(MC_TC);
+
+    if (!ev)
+        return;
+    ev->tc.type = tcp->type;
+    ev->tc.descriptor = mc_strdup(tcp->descriptor);
+    ev->tc.hint = mc_strdup(tcp->hint);
+    ev->tc.enums = copy_enums(tcp->enums);
+    ev->tc.ranges = copy_ranges(tcp->ranges);
+    ev->tc.description = mc_strdup(tcp->description);
+    ev->tc.lineno = tcp->lineno;
+}
+
+static void
+mc_record_nodes(struct node *root)
+{
+    struct mc_event *ev;
+    struct node    *np;
+    struct module  *mp;
+    int             n = 0, i;
+
+    if (!mc_rec || mc_rec->bad)
+        return;
+    for (np = root; np; np = np->next)
+        n++;
+    ev = mc_add(MC_NODES);
+    if (!ev)
+        return;
+    ev->nodes = calloc(n ? n : 1, sizeof(*ev->nodes));
+    if (!ev->nodes) {
+        mc_rec->bad = 1;
+        return;
+    }
+    ev->count = n;
+    for (np = root, i = 0; np; np = np->next, i++) {
+        mc_copy_node(&ev->nodes[i].node, np);
+        if (np->tc_index >= 0 && np->tc_index < tc_alloc) {
+            mp = find_module(tclist[np->tc_index].modid);
+            ev->nodes[i].tc_descriptor = mc_strdup(tclist[np->tc_index].descriptor);
+            ev->nodes[i].tc_module = mp ? strdup(mp->name) : NULL;
+            if (!mp)
+                mc_rec->bad = 1;
+        }
+    }
+}
+
+static struct mc_entry *
+mc_find(const char *file, const struct stat *st)
+{
+    const char     *mibdirs = netsnmp_get_mib_directory();
+    int             options = mc_options();
+    struct mc_entry *e;
+
+    for (e = mc_head; e; e = e->next)
+        if (e->mtime == st->st_mtime && e->size == st->st_size
+            && e->options == options && !strcmp(e->file, file)
+            && !strcmp(e->mibdirs, mibdirs ? mibdirs : ""))
+            return e;
+    return NULL;
+}
+
+static struct mc_entry *
+mc_start(const char *file, const struct stat *st)
+{
+    const char     *mibdirs = netsnmp_get_mib_directory();
+    struct mc_entry *e = calloc(1, sizeof(*e));
+
+    if (!e)
+        return NULL;
+    e->file = strdup(file);
+    e->mibdirs = strdup(mibdirs ? mibdirs : "");
+    if (!e->file || !e->mibdirs) {
+        mc_free_entry(e);
+        return NULL;
+    }
+    e->mtime = st->st_mtime;
+    e->size = st->st_size;
+    e->options = mc_options();
+    e->tail = &e->events;
+    return e;
+}
+
+/* Add a textual convention as parse_asntype() does */
+static void
+mc_replay_tc(const struct tc *src)
+{
+    struct tc      *tcp = NULL;
+    int             i;
+
+    for (i = 0; i < tc_alloc; i++) {
+        if (tclist[i].type == 0) {
+            if (tcp == NULL)
+                tcp = &tclist[i];
+        } else if (strcmp(src->descriptor, tclist[i].descriptor) == 0 &&
+                   tclist[i].modid == current_module) {
+            snmp_log(LOG_ERR,
+                     "Duplicate TEXTUAL-CONVENTION '%s' at line %d in %s. First at line %d\n",
+                     src->descriptor, src->lineno, File, tclist[i].lineno);
+            erroneousMibs++;
+            return;
+        }
+    }
+    if (tcp == NULL) {
+        tclist = realloc(tclist, (tc_alloc + TC_INCR)*sizeof(struct tc));
+        memset(tclist+tc_alloc, 0, TC_INCR*sizeof(struct tc));
+        tcp = tclist + tc_alloc;
+        tc_alloc += TC_INCR;
+    }
+    tcp->modid = current_module;
+    tcp->descriptor = strdup(src->descriptor);
+    tcp->hint = mc_strdup(src->hint);
+    tcp->description = mc_strdup(src->description);
+    tcp->lineno = src->lineno;
+    tcp->type = src->type;
+    tcp->ranges = copy_ranges(src->ranges);
+    tcp->enums = copy_enums(src->enums);
+}
+
+static void
+mc_replay_nodes(const struct mc_event *ev)
+{
+    struct node    *root = NULL, **tail = &root, *np;
+    struct module  *mp;
+    int             i, j, modid;
+
+    for (i = 0; i < ev->count; i++) {
+        np = malloc(sizeof(*np));
+        if (!np)
+            break;
+        mc_copy_node(np, &ev->nodes[i].node);
+        np->modid = current_module;
+        if (ev->nodes[i].tc_descriptor) {
+            modid = ev->nodes[i].tc_module ? which_module(ev->nodes[i].tc_module) : -1;
+            for (j = 0; j < tc_alloc && tclist[j].type != 0; j++)
+                if (tclist[j].modid == modid &&
+                    !strcmp(tclist[j].descriptor, ev->nodes[i].tc_descriptor)) {
+                    np->tc_index = j;
+                    break;
+                }
+        }
+        *tail = np;
+        tail = &np->next;
+    }
+    for (mp = module_head; mp; mp = mp->next)
+        if (mp->modid == current_module)
+            break;
+    do_linkup(mp, root);
+}
+
+/* Do what parsing the file of e did */
+static void
+mc_replay(const struct mc_entry *e)
+{
+    const struct mc_event *ev;
+    struct module  *mp;
+    char          **labels;
+    int             i;
+
+    for (ev = e->events; ev; ev = ev->next) {
+        switch (ev->kind) {
+        case MC_MODULE:
+            current_module = which_module(ev->name);
+            if (current_module == -1) {
+                new_module(ev->name, File);
+                current_module = which_module(ev->name);
+            }
+            for (mp = module_head; mp; mp = mp->next) {
+                if (mp->modid == current_module) {
+                    if (mp->no_imports == -1)
+                        mp->no_imports = 0;
+                    break;
+                }
+            }
+            break;
+        case MC_IMPORTS:
+            /* process_imports() may take over the labels */
+            labels = malloc((ev->count ? ev->count : 1) * sizeof(char *));
+            if (!labels)
+                break;
+            for (i = 0; i < ev->count; i++)
+                labels[i] = ev->labels[i];
+            process_imports(labels, ev->groups, ev->names, ev->count, ev->ngroups, 1);
+            free(labels);
+            break;
+        case MC_READ:
+            (void) read_module_internal(ev->name);
+            break;
+        case MC_TC:
+            mc_replay_tc(&ev->tc);
+            break;
+        case MC_NODES:
+            mc_replay_nodes(ev);
+            break;
+        }
+    }
+}
