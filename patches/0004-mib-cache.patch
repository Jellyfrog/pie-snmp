+/*
+ * Read the modules of an IMPORTS clause, in order, and save the imported
+ * descriptors in the current module (unless save is 0). Takes over the
+ * labels it saves (sets them to NULL).
+ */
+static void
+process_imports(char **labels, const int *groups, char **names,
+                int import_count, int ngroups, int save)
+{
+    char            modbuf[256];
+    struct module_import *import_list;
+    struct module  *mp;
+    int             g, i, this_module;
+
+    import_list = calloc(import_count ? import_count : 1, sizeof(*import_list));
+    if (import_list == NULL)
+        return;
+    for (i = 0; i < import_count; ++i) {
+        import_list[i].label = labels[i];
+        /* Initialize modid in case the module name was missing. */
+        import_list[i].modid = -1;
+    }
+
+    for (g = 0; g < ngroups; ++g) {
