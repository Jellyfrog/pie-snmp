From e31471d1c4e3946d125b2dac1151215b87b04f3d Mon Sep 17 00:00:00 2001
From: Jellyfrog <Jellyfrog@users.noreply.github.com>
Date: Thu, 12 Nov 2026 17:27:07 +0100
Subject: [PATCH] libsnmp: Free the import list in netsnmp_unload_module()

netsnmp_unload_module() marked the module as unloaded with
no_imports = -1 but kept its import list. Reading the module again
replaced the list without freeing it, and unload_all_mibs() frees
no_imports labels per module in a loop over (unsigned int)no_imports,
so shutting down the MIB tree after unloading a module that was not
read again freed memory far past the end of the list and crashed.

Free the labels and the list, and reset imports to NULL.
---
 snmplib/parse.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/snmplib/parse.c b/snmplib/parse.c
index d66f10432c..2d44fff552 100644
--- a/snmplib/parse.c
+++ b/snmplib/parse.c
@@ -4677,6 +4677,20 @@ netsnmp_unload_module(const char *name)
         return MODULE_NOT_FOUND;
     }
     unload_module_by_ID(modID, tree_head);
+    /*
+     * Free the import list: reading the module again builds a new one, and
+     * unload_all_mibs() frees mp->no_imports entries, which -1 would turn
+     * into a loop over (unsigned int)-1 entries. Modules without IMPORTS
+     * share root_imports, which unload_all_mibs() frees.
+     */
+    if (mp->imports && mp->imports != root_imports) {
+        int             i;
+
+        for (i = 0; i < mp->no_imports; i++)
+            SNMP_FREE(mp->imports[i].label);
+        free(mp->imports);
+    }
+    mp->imports = NULL;
     mp->no_imports = -1;        /* mark as unloaded */
     return MODULE_LOADED_OK;    /* Well, you know what I mean! */
 }
